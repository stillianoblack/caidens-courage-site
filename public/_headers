# Hashed static assets only (JS/CSS in /static/): immutable long-term caching
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker: always revalidate so browsers pick up updates promptly
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML and SPA routes: never cache so users always get latest deploy
/*
  Cache-Control: public, max-age=0, must-revalidate
