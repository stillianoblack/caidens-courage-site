# Copy to `.env.local` at project root (same folder as package.json).
# In Netlify: Site configuration → Environment variables → copy each value here.
# Restart `yarn start` after changes.

# Supabase — required for Family Portal data on localhost
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key
REACT_APP_SUPABASE_EXPECTED_PROJECT_REF=your-project-ref

# Server/CLI-only database safety gate. Never expose these as REACT_APP_* values.
SUPABASE_URL=https://your-project-ref.supabase.co
ENVIRONMENT=staging
EXPECTED_STAGING_SUPABASE_PROJECT_REF=your-staging-project-ref
PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref
ALLOW_STAGING_DATABASE_MUTATIONS=false
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
STAGING_DATABASE_URL=

# Admin portal login (localhost)
REACT_APP_ADMIN_EMAIL=you@example.com
REACT_APP_ADMIN_PASSCODE=your-passcode
# Emergency rollback only. Supabase Auth is the active Admin entry flow.
REACT_APP_ADMIN_LEGACY_EMERGENCY_ENABLED=false
PORTAL_AUTH_OWNERSHIP_ENABLED=false
REACT_APP_PORTAL_AUTH_OWNERSHIP_ENABLED=false
PORTAL_ACCESS_CODE_COMPATIBILITY_ENABLED=true
REACT_APP_PORTAL_ACCESS_CODE_COMPATIBILITY_ENABLED=true

# Optional — LaunchDarkly feature flags
REACT_APP_LAUNCHDARKLY_CLIENT_ID=

# Portal auth — legacy Blue Ribbon demo unlock (default: secure / disabled)
# REACT_APP_DEV_AUTH_BYPASS=true

# Optional — performance toggles (production uses these)
REACT_APP_DISABLE_MOTION=true
REACT_APP_ENABLE_PRELOADS=false
REACT_APP_ENABLE_INITIAL_GOAL_SELECTION=false

# Learning/engagement foundations. Keep provider delivery disabled until separately approved.
REACT_APP_LEARNING_CONTENT_ENABLED=false
LEARNING_CONTENT_ADMIN_ENABLED=false
ACHIEVEMENT_EVENTS_ENABLED=false
WEEKLY_SUMMARY_PREPARATION_ENABLED=false
WEEKLY_SUMMARY_KIT_DELIVERY_ENABLED=false
LEGACY_KIT_EVENT_ENDPOINT_ENABLED=false

# Web push (Family Portal parent reminders)
# Generate VAPID keys: npx web-push generate-vapid-keys
REACT_APP_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@caidenscourage.com
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_CHILD_INACTIVE_PUSH=false

# Kit email tagging (Netlify server-side only — never expose KIT_API_KEY to the browser)
KIT_API_KEY=
KIT_API_BASE_URL=https://api.kit.com
KIT_ENABLED=false

# Audience / CRM Phase 1 — server-side authorization flags (default disabled)
AUDIENCE_CRM_READ_ENABLED=false
AUDIENCE_ORGANIZATIONS_ENABLED=false
AUDIENCE_CLASSIFICATION_PREVIEW_ENABLED=false
CRM_BOOTSTRAP_ENABLED=false
CRM_ADMIN_DIAGNOSTICS_ENABLED=false
CRM_BOOTSTRAP_ADMIN_EMAIL=
CRM_BOOTSTRAP_SECRET=
CRM_PSEUDONYM_SALT=

# Navigation visibility only; never authorizes CRM data access
REACT_APP_AUDIENCE_CRM_DISPLAY_ENABLED=false
AUDIENCE_CRM_WRITE_ENABLED=false
AUDIENCE_ACTIVITIES_ENABLED=false
AUDIENCE_SEGMENTS_ENABLED=false
AUDIENCE_MANUAL_CONTACTS_ENABLED=false
REACT_APP_AUDIENCE_CRM_WORKFLOWS_DISPLAY_ENABLED=false
AUDIENCE_PROVIDER_SYNC_ENABLED=false
KIT_PROVIDER_ENABLED=false
KIT_WRITE_OPERATIONS_ENABLED=false
KIT_METRICS_SYNC_ENABLED=false
KIT_WEBHOOKS_ENABLED=false
KIT_MCP_ASSISTANT_ENABLED=false
KIT_WEBHOOK_SECRET=
CRM_WORKER_SECRET=
REACT_APP_AUDIENCE_PROVIDER_DISPLAY_ENABLED=false

# Optional — dev/debug
# REACT_APP_GA_DEBUG=true
# REACT_APP_PORTAL_DEV_LOG=1
# REACT_APP_SAFE_MODE=0

# Optional — facilitator shared-device student PIN continuity window (minutes, default 30)
# REACT_APP_FACILITATOR_STUDENT_CONTINUITY_MINUTES=30

# Bookstore digital delivery. Keep sales closed until KDP Select compatibility and secure delivery are confirmed.
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-only. Never prefix them with REACT_APP_.
BOOKSTORE_DIGITAL_SALES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOKSTORE_DOWNLOAD_URL_TTL_SECONDS=120
# One-time recovery links. Digital checkout also stays closed unless RESEND_API_KEY is set.
BOOKSTORE_RECOVERY_TOKEN_TTL_SECONDS=1800
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# Optional override for the Kindle product page. Leave blank to use the catalog URL
# https://www.amazon.com/dp/B0HNDXXRBV (ASIN B0HNDXXRBV). Do not put the author page here.
REACT_APP_KINDLE_PRODUCT_URL=

# Academy membership. The access gate stays off until staging billing tests pass.
# A live Stripe key cannot grant memberships. Do not send transition emails from this flag alone.
ACADEMY_MEMBERSHIP_GATE_ENABLED=false
ACADEMY_TRANSITION_EMAILS_ENABLED=false
# ISO timestamp. Families created before this stay on the proposed complimentary transition.
# Leave blank so the gate cannot lock existing families.
ACADEMY_MEMBERSHIP_EXISTING_FAMILY_CUTOFF=
# Encrypts bundle claim codes. Never prefix with REACT_APP_.
ACADEMY_CLAIM_CODE_KEY=
# Optional separate webhook secret for /.netlify/functions/academy-stripe-webhook
# ACADEMY_STRIPE_WEBHOOK_SECRET=
# Test-mode price ids are saved by the admin function after Stripe verification.
# STRIPE_ACADEMY_MONTHLY_PRICE_ID=
# STRIPE_ACADEMY_ANNUAL_PRICE_ID=
# Bundle checkout stays closed until this is true AND a verified test price, shipping rate, and Resend key exist.
BOOKSTORE_BUNDLE_SALES_ENABLED=false
REACT_APP_BOOKSTORE_BUNDLE_CHECKOUT_ENABLED=false
# Comma-separated Stripe test shipping rate ids, each starting with shr_.
STRIPE_BUNDLE_SHIPPING_RATE_IDS=
STRIPE_AUTOMATIC_TAX_ENABLED=false
