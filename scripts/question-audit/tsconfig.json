{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "*": ["../src/*", "../node_modules/*"]
    }
  },
  "include": ["./**/*", "../src/data/**/*", "../src/lib/weeklyCharacterMissionLists.ts", "../src/lib/weeklyCharacterMissions.ts", "../src/types/**/*"]
}
